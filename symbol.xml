<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#222222"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_1"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="1"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="35dp"/>

        <TextView
            android:id="@+id/btn_2"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="2"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="35dp"/>

        <TextView
            android:id="@+id/btn_3"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="3"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:layout_marginStart="3dp"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="35dp"/>

        <TextView
            android:id="@+id/btn_4"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="4"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:layout_marginStart="3dp"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_height="35dp"/>

        <TextView
            android:id="@+id/btn_5"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="5"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginStart="3dp"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="35dp"/>

        <TextView
            android:id="@+id/btn_6"
            android:layout_width="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:text="6"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="35dp"/>

        <TextView
            android:id="@+id/btn_7"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="7"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginStart="3dp"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="35dp"/>

        <TextView
            android:id="@+id/btn_8"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:textStyle="bold"
            android:textSize="15sp"
            android:text="8"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="35dp"/>

        <TextView
            android:id="@+id/btn_9"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="9"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="35dp"/>

        <TextView
            android:id="@+id/btn_0"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="35dp"/>

    </LinearLayout>

    <!-- Первый ряд символов: + - = * / % ( ) < > -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/btn_plus"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="+"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_minus"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="-"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_equal"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="="
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_multiply"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="*"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_slash"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="/"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_percent"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="%"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_paren_open"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="("
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_paren_close"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text=")"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_less"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="&lt;"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_greater"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="&gt;"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

    </LinearLayout>

    <!-- Второй ряд символов: ! \@ # $ ~ \? { } [ ] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/btn_exclamation"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="!"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_at"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="\@"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_hash"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="#"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_dollar"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="$"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_tilde"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="~"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_question"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="\?"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_brace_open"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="{"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_brace_close"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="}"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_bracket_open"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="["
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_bracket_close"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="]"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

    </LinearLayout>

    <!-- Третий ряд символов: x \ | : ; " ' , . ⌫ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/btn_x"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="x"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_backslash"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="\\"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_pipe"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="|"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_colon"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text=":"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_semicolon"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text=";"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_quote"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="&quot;"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_single_quote"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="\'"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_comma"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text=","
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_dot"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:text="."
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="15dp"
            android:layout_weight="1"
            android:text="⌫"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:background="@drawable/round2"
            android:gravity="center"
            android:layout_height="40dp"/>

    </LinearLayout>

    <!-- Нижний ряд (Переключение на буквы, язык, Пробел, Ввод) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_sumbol"
            android:layout_width="wrap_content"
            android:text="АБВ"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/round2"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_language"
            android:layout_width="wrap_content"
            android:text="🌐"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_marginStart="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/round2"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_space"
            android:layout_width="wrap_content"
            android:text="Пробел"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_marginStart="3dp"
            android:textStyle="bold"
            android:layout_weight="2"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/round"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_setting"
            android:layout_width="wrap_content"
            android:text="⚙"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginStart="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/round2"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_enter"
            android:layout_width="wrap_content"
            android:text="↵"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginStart="3dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/round2"
            android:gravity="center"
            android:layout_height="40dp"/>

        <TextView
            android:id="@+id/btn_enter_search"
            android:layout_width="wrap_content"
            android:text="🔍"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginStart="3dp"
            android:textStyle="bold"
            android:visibility="gone"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/round2"
            android:gravity="center"
            android:layout_height="40dp"/>

    </LinearLayout>

</LinearLayout>
